# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional direct web API URL. Leave empty to use the Vite proxy to 127.0.0.1:8000.
# For a direct local web call, set this to "http://127.0.0.1:8000".
VITE_API_BASE_URL=""

# BACKEND_CORS_ORIGINS: Comma-separated browser origins allowed to call FastAPI.
# Leave unset during local development to use the localhost defaults.
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# TerraGuard SMS Gateway & India DLT Activation Configuration
# Default is SMS_DEMO_MODE=true for truthful demonstration without live DLT activation
SMS_PROVIDER="sms_horizon"
SMS_DEMO_MODE=true
SMSHORIZON_API_KEY=""
SMSHORIZON_SENDER_ID=""
SMSHORIZON_DLT_ENTITY_ID=""
SMSHORIZON_TEMPLATE_ID=""
SMSHORIZON_API_URL="https://smshorizon.in/api/sendsms.php"

